# ─────────────────────────────────────────────────────────────────────────────
# .env.example – copia in .env e compila con i tuoi valori
# NON committare mai il file .env
# ─────────────────────────────────────────────────────────────────────────────

# ── DuckDNS (DNS dinamico) ───────────────────────────────────────────────────
# Il sottodominio registrato su duckdns.org (senza ".duckdns.org")
DUCKDNS_SUBDOMAINS=tuo-sottodominio
# Token personale dalla dashboard di duckdns.org
DUCKDNS_TOKEN=il-tuo-token-duckdns

# ── App Auth ─────────────────────────────────────────────────────────────────
# Segreto JWT – minimo 32 caratteri, generane uno casuale con:
#   openssl rand -base64 48
JWT_SECRET=cambiami-con-un-segreto-casuale-lungo
